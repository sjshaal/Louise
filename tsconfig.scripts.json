{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist-scripts"
  },
  "include": ["scripts/**/*.ts", "lib/**/*.ts", "data/**/*.json"]
}
